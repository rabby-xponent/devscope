# === LLM providers ===
# Set one or more API keys. The gateway picks the highest-priority healthy provider.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER_OVERRIDE=gemini
# LLM_CACHE_ENABLED=true
# LLM_CACHE_DIR=./cache/llm
# LLM_CACHE_TTL_MINUTES=60
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=DevScope

# Optional per-provider model overrides
# GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=meta-llama/llama-4-scout:free
GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_MODEL=qwen-plus
# OPENAI_MODEL=gpt-4o-mini

# === GitHub ===
GITHUB_TOKEN=your_github_token

# === Server config ===
PORT=4000
FRONTEND_URL=http://localhost:3000

# === Cache config ===
CACHE_DIR=./cache/profiles
CACHE_TTL_HOURS=24

# === Anonymous demo gate (M24A) ===
# DEMO_LIMIT=off disables the 1-fresh-audit-per-profile gate (dev/testing only)
# DEMO_IP_HOURLY_CAP=10 (IP backstop for cookie-clearing abuse)

# === Accounts & workspace storage (M24B-M24D) ===
# Create a Supabase project, then run backend/src/auth/supabase-setup.sql in its
# SQL editor. Until these are set the backend stays in local mode: auth routes
# answer 503, /api/dev-auth can mint sessions (DEV_AUTH_MODE=on, local only),
# and the usage ledger falls back to in-memory metering.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
# SUPABASE_JWT_SECRET=legacy-jwt-secret (Settings > API > JWT Settings)
# DEV_AUTH_MODE=on enables POST /api/dev-auth when Supabase is NOT configured.
# In Supabase dashboard: enable the GitHub OAuth provider (needs a GitHub OAuth
# app with callback https://<project-ref>.supabase.co/auth/v1/callback) and the
# email magic-link provider.
