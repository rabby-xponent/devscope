# === LLM providers ===
# Set one or more API keys. The gateway picks the highest-priority healthy provider.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER_OVERRIDE=gemini
# LLM_CACHE_ENABLED=true
# LLM_CACHE_DIR=./cache/llm
# LLM_CACHE_TTL_MINUTES=60
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=DevScope

# Optional per-provider model overrides
# GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=meta-llama/llama-4-scout:free
GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_MODEL=qwen-plus
# OPENAI_MODEL=gpt-4o-mini

# === GitHub ===
GITHUB_TOKEN=your_github_token

# === Server config ===
PORT=4000
FRONTEND_URL=http://localhost:3000

# === Cache config ===
CACHE_DIR=./cache/profiles
CACHE_TTL_HOURS=24
